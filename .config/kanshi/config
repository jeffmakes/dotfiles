# To make a new profile, plug in the monitor, and run wdisplays. Arrange the displays how you want them, then write a block like those below.
# To get the monitors name, run swaymsg -t get_outputs

profile lounge {
  output eDP-1 position 960,2160
  output "Microstep MAG321CURV DA2A019160072" mode 3840x2160@30Hz position 0,0
  output "Samsung Electric Company U28E590 HTPJ203148" mode 3840x2160@30Hz position 3840,0
  exec swaymsg "output \"Microstep MAG321CURV DA2A019160072\" mode 3840x2160@30Hz"  # hack - for some reason kanshi cant set the freq
  exec swaymsg "output \"Samsung Electric Company U28E590 HTPJ203148\" mode 3840x2160@30Hz"  # hack - for some reason kanshi cant set the freq
  exec swaymsg workspace 1, move workspace to output "Microstep MAG321CURV DA2A019160072"
  exec swaymsg workspace 2, move workspace to output "Samsung Electric Company U28E590 HTPJ203148"
  exec swaymsg workspace 3, move workspace to output eDP-1
  #exec swaymsg gaps inner all set 30
  #exec swaymsg gaps inner 30
}

